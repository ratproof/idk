
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "stains": {
      "root": "stains",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/commands",
      "destination": "https://bucket.stains.rocks/api/commands"
    },
    {
      "source": "/api/status",
      "destination": "https://bucket.stains.rocks/api/status"
    },
    {
      "source": "/api/dash/:path*",
      "destination": "https://bucket.stains.rocks/api/dash/:path*"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
